           padx=(0, 8) if c == 0 else (8, 0), pady=(0, 8) if r == 0 else (8, 0))
    ctk.CTkLabel(f, text=title, font=("Segoe UI", 14, "bold"), text_color=txt).pack(anchor="w", padx=16, pady=(14, 4))
    return f

