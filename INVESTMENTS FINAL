def get_db():
    return mysql.connector.connect(host=DB_HOST, user=DB_USER,
                                   password=DB_PASS, database=DB_NAME)


def init_db():
    try:
        c = mysql.connector.connect(host=DB_HOST, user=DB_USER,
                                    password=DB_PASS)
        cur = c.cursor()
        cur.execute(f"CREATE DATABASE IF NOT EXISTS {DB_NAME}")
        cur.execute(f"USE {DB_NAME}")
        cur.execute("""CREATE TABLE IF NOT EXISTS holdings(
                        id INT AUTO_INCREMENT PRIMARY KEY,
                        name VARCHAR(255),ticker VARCHAR(50),type VARCHAR(50),
                        sub VARCHAR(255),invested DOUBLE,value DOUBLE,
                        color VARCHAR(20),letter VARCHAR(10),created_at DATETIME)""")
        cur.execute("""CREATE TABLE IF NOT EXISTS portfolio_history(
                        id INT AUTO_INCREMENT PRIMARY KEY,
                        recorded_at DATETIME,total_value DOUBLE,total_invested DOUBLE)""")
        c.commit(); c.close()
    except Exception as e:
        print(f"DB init notice: {e}")


def load_from_db():
    global lst, his
    try:
        c = get_db(); cur = c.cursor(dictionary=True)
        cur.execute("SELECT * FROM holdings ORDER BY id")
        lst = [{k: (float(v) if k in ("invested", "value") else v)
                for k, v in row.items()} for row in cur.fetchall()]
        cur.execute("SELECT recorded_at,total_value,total_invested FROM portfolio_history")
        his = [(r["recorded_at"], float(r["total_value"]),
                float(r["total_invested"])) for r in cur.fetchall()]
        c.close()
        if lst and not his:
            his.append((datetime.now(),
                        sum(h["value"] for h in lst),
                        sum(h["invested"] for h in lst)))
    except Exception as e:
        print(f"DB load notice: {e}")


def save_holding_to_db(h):
    try:
        c = get_db(); cur = c.cursor()
        cur.execute("""INSERT INTO holdings(name,ticker,type,sub,invested,value,
                        color,letter,created_at) VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s)""",
                    (h["name"], h["ticker"], h["type"], h["sub"],
                     h["invested"], h["value"], h["color"],
                     h["letter"], h["added_at"]))
        h["id"] = cur.lastrowid
        tv, ti = sum(i["value"] for i in lst), sum(i["invested"] for i in lst)
        cur.execute("""INSERT INTO portfolio_history(recorded_at,total_value,total_invested)
                       VALUES(%s,%s,%s)""",
                    (h["added_at"], tv, ti))
        c.commit(); c.close()
    except Exception as e:
        messagebox.showerror("DB Error", f"Save failed:\n{e}")


def delete_holding_from_db(hid):
    global lst, his
    try:
        c = get_db(); cur = c.cursor()
        cur.execute("DELETE FROM holdings WHERE id=%s", (hid,))
        c.commit(); c.close()
        lst = [h for h in lst if h.get("id") != hid]
        his.append((datetime.now(),
                    sum(h["value"] for h in lst),
                    sum(h["invested"] for h in lst)))
        ref()
    except Exception as e:
        messagebox.showerror("DB Error", f"Delete failed:\n{e}")


def update_holding_in_db(hid, h):
    try:
        c = get_db(); cur = c.cursor()
        cur.execute("""UPDATE holdings SET invested=%s,value=%s,color=%s,
                       letter=%s,created_at=%s WHERE id=%s""",
                    (h["invested"], h["value"], h["color"],
                     h["letter"], h["added_at"], hid))
        c.commit(); c.close()
    except Exception as e:
        messagebox.showerror("DB Error", f"Update failed:\n{e}")


def inr(n):
    n = int(round(n))
    s = str(abs(n))
    if len(s) <= 3:
        res = s
    else:
        l3, rst, grp = s[-3:], s[:-3], []
        while len(rst) > 2:
            grp.append(rst[-2:]); rst = rst[:-2]
        if rst: grp.append(rst)
        grp.reverse()
        res = ",".join(grp) + "," + l3
    return ("-Rs. " if n < 0 else "Rs. ") + res


def pcl(v): return grn if v >= 0 else red


