                 text_color=mut).pack(anchor="w")
    cop = ["Gold", "Blue", "Emerald", "Coral", "Purple", "Teal", "Amber"]
    cva = ["#C9A96E", "#4E80EE", "#38A169", "#E56B6F",
           "#9D72FF", "#319795", "#D69E2E"]
    ccl = ctk.CTkComboBox(r4, values=cop,
                          font=("Segoe UI", 14),
