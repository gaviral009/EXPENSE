    rlb.configure(text=inr(gl), text_color=pcl(gl))
    plb.configure(text=f"{s}{round(pct,2)}%", text_color=pcl(pct))
    clb.configure(text=f"{s}{round(pct,2)}% total", text_color=pcl(pct))
